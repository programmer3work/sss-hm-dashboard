# Point TTS at the local FastAPI proxy during development.
NEXT_PUBLIC_TTS_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_TTS_API_PATH=/tts/text-to-voice

# Comma-separated language-to-code overrides, when required by a provider.
NEXT_PUBLIC_TTS_LANGUAGE_CODES=English:en,Telugu:te,Hindi:hi,Tamil:ta,Kannada:kn